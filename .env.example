# bedrock = Amazon Bedrock via the AWS credential chain (default for the CLI)
# scripted = deterministic stand-in used by pytest and the saved traces
HOSTEL_MODEL=bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Freeze the kitchen clock for demos. Example: 2026-11-24T08:30:00
HOSTEL_NOW=2026-11-24T08:30:00

# Optional override. Defaults to ./data
# HOSTEL_DATA_DIR=

# Used only by the standalone MCP process (Cursor inspector / smoke tests).
# The guest chat binds identity in code and does not read these per turn.
HOSTEL_GUEST_ID=g-305
HOSTEL_ROOM=305
